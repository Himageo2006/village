<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:screenOrientation="portrait"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions: none, and that is the whole list.

         The Capacitor template declares INTERNET. This game does not use it.
         It reaches for nothing off the phone -- no http, no localhost, no
         fetch anywhere in the shipped code, which check-android.js now holds
         it to -- and Capacitor serves the page by intercepting the WebView's
         own requests and reading out of assets rather than over a socket, so
         nothing underneath needs it either.

         A game that asks for no permissions at all is also the honest thing
         to put in front of somebody on a store page.

         cap sync and any plugin added later can both put one back without a
         word, so check-android.js fails the build on any uses-permission that
         appears here. If one is ever genuinely needed, add it AND the reason
         to that check, deliberately. -->
</manifest>
