node_modules/
# captured screenshots from server.js
cap/
# generated by scripts/sync-www.js on every build
www/
# working screenshots at the repo root
/*.png

# art/ is NOT ignored -- generated sprites belong in version control.
# android/ is NOT ignored either: the manifest and variables.gradle carry real
# edits (portrait lock, target SDK) that must not be lost to a regeneration.
android/build/
android/app/build/
android/.gradle/
android/captures/
android/local.properties
android/app/src/main/assets/public/

# signing material never goes near the repo
*.keystore
*.jks
android/keystore.properties
